# Copy to .env and fill in. .env is gitignored and is never read by Claude.
# Ontraport -> Administration -> Integrations -> Ontraport API Instructions and Key Manager
ONTRAPORT_APP_ID=
ONTRAPORT_API_KEY=

# Point at a test contact set until we have verified behaviour end to end.
ONTRAPORT_MODE=fake   # fake | live

# Postgres. Without it the app falls back to SQLite — a local file in
# development, and in memory on a serverless host, where every lead is lost
# when the instance recycles. Set this before the site collects anything real.
# Neon and Supabase both have a free tier that suits this.
DATABASE_URL=

# Set to 1 to show internal notes, SEO diagnostics and the screen switcher.
# Never set in a deployed environment.
REVIEW_NAV=
